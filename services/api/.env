# CareConnect Telehealth Platform - Local Development Environment
# WARNING: These values are for LOCAL DEVELOPMENT ONLY.
# Production must use a secrets manager (SRS §10.2).

# ── Application ──────────────────────────────────────────────────
APP_NAME=CareConnect Telehealth
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3005","http://localhost:3006","http://localhost:19006","http://localhost:4000","http://localhost:4001","http://localhost:3000","http://localhost:3001"]

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://careconnect:password@localhost:5433/careconnect_db
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Object Storage (MinIO) ───────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=careconnect-documents

# ── JWT / OAuth2 ─────────────────────────────────────────────────
JWT_SECRET_KEY=dev-only-change-in-production-use-kms
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ── Notifications (MailHog) ──────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@careconnect.health
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
