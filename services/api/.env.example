# Local development ONLY. Replace all secrets for staging/production.
ENVIRONMENT=local
DEBUG=false
ENABLE_DEMO_PROVIDERS=false
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3006
DATABASE_URL=postgresql+asyncpg://careconnect:password@localhost:5433/careconnect_db
REDIS_URL=redis://localhost:6380/0
JWT_SECRET_KEY=replace-with-long-random-local-dev-secret
JWT_AUDIENCE=careconnect-api
OIDC_ISSUER_URL=http://localhost:8005/api/v1/auth
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
SMTP_HOST=localhost
SMTP_PORT=1025

# Per-peer limits. For a shared BFF/proxy, size aggregate limits to measured load
# and enforce per-client limits at a trusted edge. Never trust arbitrary XFF.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AUTH_ACCOUNT_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10
